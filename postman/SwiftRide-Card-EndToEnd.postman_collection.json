          "name": "5.2 Poll CARD payment outcome",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('tripId')) {",
                  "  pm.test('Cần tripId từ bước 3.2', () => pm.expect.fail('Không chạy bước 5 khi tripId rỗng'));",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const url = pm.variables.replaceIn('{{gatewayUrl}}/payments/by-trip/{{tripId}}');",
                  "const token = pm.environment.get('riderToken');",
                  "for (let attempt = 1; attempt <= 30; attempt++) {",
                  "  const response = await pm.sendRequest({ url, method: 'GET', header: { Authorization: 'Bearer ' + token } });",
                  "  if (response.code === 200) { console.log('Payment có sau', attempt, 'lần'); break; }",
                  "  if (response.code !== 404) { console.warn('Payment trả', response.code); break; }",
                  "  if (attempt < 30) await new Promise(resolve => setTimeout(resolve, 2000));",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment đã xuất hiện (200, không chấp nhận 404)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const payment = pm.response.json();",
                  "  pm.environment.set('paymentId', payment.id);",
                  "  pm.test('Đúng tripId', () => pm.expect(payment.tripId).to.eql(pm.environment.get('tripId')));",
                  "  console.log('Payment final:', payment.status, 'failureReason:', payment.failureReason, 'paymentId:', payment.id);",
                  "  pm.test('Payment đúng kết quả CARD', () => pm.expect(payment.status, payment.failureReason || '').to.eql(pm.environment.get('expectedPaymentStatus') || 'SUCCEEDED'));",
                  "}",
                  "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
                ],
                "type": "text/javascript"
              }
            }
