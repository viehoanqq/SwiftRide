{
  "info": {
    "_postman_id": "67ad5d09-c4b5-4808-9066-3fc511bb1461",
    "name": "SwiftRide - CARD end-to-end (approved, declined, unknown)",
    "description": "CARD simulator: only when Payment runs Development/Testing with FakeCard enabled. Set cardToken, expectedTripStatus and expectedPaymentStatus in environment for each new trip.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. System Health Check",
      "item": [
        {
          "name": "0.1 Check Gateway & All Microservices Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway trả về 200 Healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('Healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Kiểm tra trạng thái kết nối Database của cả 4 microservice thông qua API Gateway."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. Auth & Onboarding (Identity Service)",
      "item": [
        {
          "name": "1.1 Login Rider (configured account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đăng nhập Rider thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res && res.accessToken) {",
                  "    pm.environment.set('riderToken', res.accessToken);",
                  "    pm.environment.set('riderId', res.user.id);",
                  "    console.log('Đã lưu riderToken và riderId:', res.user.id);",
                  "}",
                  "",
                  "pm.test('User có role là Rider', function () {",
                  "    pm.expect(res.user.role).to.eql('Rider');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{cardRiderPhone}}\",\n  \"password\": \"{{defaultPassword}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập tài khoản Rider01 có sẵn trong SeedData (Số dư ví: 500.000đ) và tự động lưu `riderToken`, `riderId` vào Environment."
          },
          "response": []
        },
        {
          "name": "1.2 Get Rider Profile (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy thông tin Rider thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(pm.environment.get('riderId'));",
                  "    pm.expect(res.role).to.eql('Rider');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/auth/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Login Driver (configured account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đăng nhập Driver thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res && res.accessToken) {",
                  "    pm.environment.set('driverToken', res.accessToken);",
                  "    pm.environment.set('driverId', res.user.id);",
                  "    console.log('Đã lưu driverToken và driverId:', res.user.id);",
                  "}",
                  "",
                  "pm.test('User có role là Driver', function () {",
                  "    pm.expect(res.user.role).to.eql('Driver');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{cardDriverPhone}}\",\n  \"password\": \"{{defaultPassword}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập tài khoản Driver01 (Lê Văn Cường) và tự động lưu `driverToken`, `driverId` vào Environment."
          },
          "response": []
        },
        {
          "name": "1.4 Get Driver Profile (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy thông tin Driver thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(pm.environment.get('driverId'));",
                  "    pm.expect(res.role).to.eql('Driver');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/auth/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Driver Availability (Matching Service)",
      "item": [
        {
          "name": "2.1 Driver Set Online & Update GPS Location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Driver sẵn sàng nhận chuyến (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const status = pm.response.json().status;",
                  "  pm.test('Driver Available', () => pm.expect(status).to.eql('Available'));",
                  "  if (status !== 'Available') pm.execution.setNextRequest(null);",
                  "} else {",
                  "  console.warn('Driver đang bận hoặc API lỗi:', pm.response.text());",
                  "  pm.execution.setNextRequest(null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": {{pickupLat}},\n  \"lng\": {{pickupLng}}\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/availability/online",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "availability",
                "online"
              ]
            },
            "description": "Tài xế bật trạng thái sẵn sàng nhận chuyến (`Available`) tại vị trí gần điểm đón để đảm bảo được chọn khi ghép chuyến."
          },
          "response": []
        },
        {
          "name": "2.2 Driver Get My Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Driver sẵn sàng nhận chuyến (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const status = pm.response.json().status;",
                  "  pm.test('Driver Available', () => pm.expect(status).to.eql('Available'));",
                  "  if (status !== 'Available') pm.execution.setNextRequest(null);",
                  "} else {",
                  "  console.warn('Driver đang bận hoặc API lỗi:', pm.response.text());",
                  "  pm.execution.setNextRequest(null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/availability/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "availability",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Rider Booking & Quote Confirmation (Trip Service)",
      "item": [
        {
          "name": "3.1 Rider Check Wallet Before Trip (/wallets/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy thông tin ví Rider thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('balance');",
                  "    pm.environment.set('cardRiderBalanceBefore', res.balance);",
                  "    console.log('Số dư ví Rider trước chuyến đi:', res.balance);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/wallets/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "wallets",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.2 Rider Create Trip & Get Fare Quote (POST /trips)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('tripId'); pm.environment.unset('offerId'); pm.environment.unset('paymentId');",
                  "pm.test('Tạo chuyến mới (201)', () => pm.response.to.have.status(201));",
                  "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); }",
                  "else {",
                  "  const trip = pm.response.json();",
                  "  pm.test('Response có tripId hợp lệ', () => pm.expect(trip.tripId).to.match(/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i));",
                  "  pm.test('Chuyến Quoted và có giá', () => { pm.expect(trip.status).to.eql('Quoted'); pm.expect(trip.price).to.be.above(0); });",
                  "  if (trip.tripId) pm.environment.set('tripId', trip.tripId);",
                  "  else pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"lat\": {{pickupLat}},\n    \"lng\": {{pickupLng}},\n    \"address\": \"{{pickupAddress}}\"\n  },\n  \"dropoff\": {\n    \"lat\": {{dropoffLat}},\n    \"lng\": {{dropoffLng}},\n    \"address\": \"{{dropoffAddress}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/trips",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips"
              ]
            },
            "description": "Rider tạo yêu cầu đặt xe. Trip Service gọi nội bộ sang Matching Service (`POST /quote`) để tính giá và chuyển chuyến sang trạng thái `Quoted`. Tự động lưu `tripId`."
          },
          "response": []
        },
        {
          "name": "3.3 Rider Get Current Active Trip (/trips/me/current)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy chuyến hiện tại của Rider thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(pm.environment.get('tripId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/trips/me/current",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips",
                "me",
                "current"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.4 Rider Confirm Fare Quote & Match Nearest Driver",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tripId = pm.environment.get('tripId');",
                  "if (!tripId) {",
                  "  pm.test('Cần tripId từ bước 3.2', () => pm.expect.fail('Chạy toàn bộ collection từ 3.2; không gọi /trips//...'));",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const token = pm.variables.get('cardToken');",
                  "if (!['test-card-approved','test-card-declined','test-card-unknown'].includes(token)) {",
                  "  pm.test('CARD cần test token hợp lệ', () => pm.expect.fail('Đặt cardToken trong environment hoặc collection; không gửi {{cardToken}} nguyên văn'));",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Xác nhận giá và mời Driver (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const result = pm.response.json();",
                  "  pm.test('Đã có lời mời', () => pm.expect(result.status).to.eql('DriverOffered'));",
                  "  if (result.status !== 'DriverOffered') pm.execution.setNextRequest(null);",
                  "} else pm.execution.setNextRequest(null);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": true,\n  \"paymentMethod\": \"CARD\",\n  \"cardToken\": \"{{cardToken}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/trips/{{tripId}}/confirm",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips",
                "{{tripId}}",
                "confirm"
              ]
            },
            "description": "CARD cần cardToken; tạo chuyến mới cho từng kịch bản."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Driver Trip Execution (Offer -> EnRoute -> Pickup -> Dropoff)",
      "item": [
        {
          "name": "4.1 Driver Poll Pending Offers (/drivers/me/offers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy danh sách offer (200)', () => pm.response.to.have.status(200));",
                  "const tripId = pm.environment.get('tripId');",
                  "pm.test('Có tripId từ bước 3.2', () => pm.expect(tripId).to.be.ok);",
                  "if (pm.response.code !== 200 || !tripId) pm.execution.setNextRequest(null);",
                  "else {",
                  "  const offers = pm.response.json();",
                  "  const target = Array.isArray(offers) ? offers.find(o => o.tripId === tripId) : undefined;",
                  "  pm.test('Driver được mời đúng chuyến', () => pm.expect(target, 'Đăng nhập Driver được mời rồi gọi lại 4.1').to.exist);",
                  "  if (target) pm.environment.set('offerId', target.offerId);",
                  "  else pm.execution.setNextRequest(null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/drivers/me/offers",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "drivers",
                "me",
                "offers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4.2 Driver Accept Offer (/trips/{id}/driver-accept)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tripId = pm.environment.get('tripId');",
                  "if (!tripId) {",
                  "  pm.test('Cần tripId từ bước 3.2', () => pm.expect.fail('Chạy toàn bộ collection từ 3.2; không gọi /trips//...'));",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Driver nhận chuyến (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test('Trạng thái DriverAccepted', () => pm.expect(pm.response.json().status).to.eql('DriverAccepted'));",
                  "else pm.execution.setNextRequest(null);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/trips/{{tripId}}/driver-accept",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips",
                "{{tripId}}",
                "driver-accept"
              ]
            },
            "description": "Tài xế chấp nhận lời mời. Chuyến đi chuyển sang `DriverAccepted` và Trip Service gọi nội bộ sang Matching Service (`PUT /drivers/{id}/status`) để đổi trạng thái tài xế sang `Busy`."
          },
          "response": []
        },
        {
          "name": "4.3 Driver Get Current Trip (/drivers/me/current-trip)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Xem chuyến đang chạy (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const trip = pm.response.json();",
                  "  pm.test('Đúng tripId mới', () => pm.expect(trip.id).to.eql(pm.environment.get('tripId')));",
                  "  pm.test('Đã nhận chuyến', () => pm.expect(trip.status).to.eql('DriverAccepted'));",
                  "  if (trip.id !== pm.environment.get('tripId')) pm.execution.setNextRequest(null);",
                  "} else pm.execution.setNextRequest(null);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/drivers/me/current-trip",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "drivers",
                "me",
                "current-trip"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4.4 Driver Mark EnRoute (/trips/{id}/en-route)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tripId = pm.environment.get('tripId');",
                  "if (!tripId) {",
                  "  pm.test('Cần tripId từ bước 3.2', () => pm.expect.fail('Chạy toàn bộ collection từ 3.2; không gọi /trips//...'));",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chuyển EnRoute (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test('Trạng thái EnRoute', () => pm.expect(pm.response.json().status).to.eql('EnRoute'));",
                  "else pm.execution.setNextRequest(null);"
                ],
                "type": "text/javascript"
              }
