      "item": [
        {
          "name": "5.1 Poll CARD trip outcome",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('tripId')) {",
                  "  pm.test('Cần tripId từ bước 3.2', () => pm.expect.fail('Không chạy bước 5 khi tripId rỗng'));",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const url = pm.variables.replaceIn('{{gatewayUrl}}/trips/{{tripId}}');",
                  "const token = pm.environment.get('riderToken');",
                  "const expected = pm.environment.get('expectedTripStatus') || 'Paid';",
                  "for (let attempt = 1; attempt <= 30; attempt++) {",
                  "  const response = await pm.sendRequest({ url, method: 'GET', header: { Authorization: 'Bearer ' + token } });",
                  "  if (response.code !== 200) { console.warn('Trip trả', response.code); break; }",
                  "  const status = response.json().status;",
                  "  if (status === expected || status === 'Paid' || status === 'PaymentFailed') { console.log('Trip:', status, 'lần', attempt); break; }",
                  "  if (attempt < 30) await new Promise(resolve => setTimeout(resolve, 2000));",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Xem chuyến (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const trip = pm.response.json();",
                  "  pm.test('Đúng tripId', () => pm.expect(trip.id).to.eql(pm.environment.get('tripId')));",
                  "  pm.test('Trip đúng kết quả CARD', () => pm.expect(trip.status).to.eql(pm.environment.get('expectedTripStatus') || 'Paid'));",
                  "  if (trip.status !== (pm.environment.get('expectedTripStatus') || 'Paid')) pm.execution.setNextRequest(null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
