{
  "info": {
    "name": "SwiftRide - Register Rider and Driver",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run once for new phone numbers. No wallet balance changes."
  },
  "item": [
    {
      "name": "01. Register and login Rider / Driver",
      "item": [
        {
          "name": "Register Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{onboardingBody}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const phone = String(pm.environment.get('riderPhone') || '').trim();",
                  "const password = String(pm.environment.get('defaultPassword') || '');",
                  "if (!/^0[0-9]{9}$/.test(phone) || password.length < 6 || phone === String(pm.environment.get('driverPhone') || '').trim()) {",
                  "    pm.execution.setNextRequest(null); pm.execution.skipRequest();",
                  "    throw new Error('Use two different 10-digit phone numbers and password of at least 6 characters.');",
                  "}",
                  "pm.environment.unset('riderToken'); pm.environment.unset('riderId');",
                  "pm.variables.set('onboardingBody', JSON.stringify({fullName: pm.environment.get('riderFullName'), phone, password, role: 'Rider'}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let body = {}; try { body = pm.response.json(); } catch {}",
                  "const ok = pm.response.code === 201 || (pm.response.code === 409 && body.code === 'PHONE_ALREADY_EXISTS');",
                  "pm.test('Registered or existing phone; login must verify ownership next', () => pm.expect(ok).to.eql(true));",
                  "if (!ok) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{onboardingBody}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('onboardingBody', JSON.stringify({phone: String(pm.environment.get('riderPhone')).trim(), password: pm.environment.get('defaultPassword')}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let body = {}; try { body = pm.response.json(); } catch {}",
                  "const ok = pm.response.code === 200 && !!body.accessToken && body.user?.role === 'Rider' && body.user?.phone === String(pm.environment.get('riderPhone')).trim();",
                  "pm.test('Login correct phone and role', () => pm.expect(ok).to.eql(true));",
                  "if (ok) { pm.environment.set('riderToken', body.accessToken); pm.environment.set('riderId', body.user.id); }",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{onboardingBody}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const phone = String(pm.environment.get('driverPhone') || '').trim();",
                  "const password = String(pm.environment.get('defaultPassword') || '');",
                  "if (!/^0[0-9]{9}$/.test(phone) || password.length < 6 || phone === String(pm.environment.get('riderPhone') || '').trim()) {",
                  "    pm.execution.setNextRequest(null); pm.execution.skipRequest();",
                  "    throw new Error('Use two different 10-digit phone numbers and password of at least 6 characters.');",
                  "}",
                  "pm.environment.unset('driverToken'); pm.environment.unset('driverId');",
                  "pm.variables.set('onboardingBody', JSON.stringify({fullName: pm.environment.get('driverFullName'), phone, password, role: 'Driver'}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let body = {}; try { body = pm.response.json(); } catch {}",
                  "const ok = pm.response.code === 201 || (pm.response.code === 409 && body.code === 'PHONE_ALREADY_EXISTS');",
                  "pm.test('Registered or existing phone; login must verify ownership next', () => pm.expect(ok).to.eql(true));",
                  "if (!ok) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{onboardingBody}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('onboardingBody', JSON.stringify({phone: String(pm.environment.get('driverPhone')).trim(), password: pm.environment.get('defaultPassword')}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let body = {}; try { body = pm.response.json(); } catch {}",
                  "const ok = pm.response.code === 200 && !!body.accessToken && body.user?.role === 'Driver' && body.user?.phone === String(pm.environment.get('driverPhone')).trim();",
                  "pm.test('Login correct phone and role', () => pm.expect(ok).to.eql(true));",
                  "if (ok) { pm.environment.set('driverToken', body.accessToken); pm.environment.set('driverId', body.user.id); }",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for Rider wallet (UserRegistered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/wallets/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let ready = false;",
                  "for (let attempt = 0; attempt < 60; attempt++) {",
                  "    const response = await pm.sendRequest({url: pm.environment.get('gatewayUrl') + '/wallets/me', method: 'GET', header: {Authorization: 'Bearer ' + pm.environment.get('riderToken')}});",
                  "    if (response.code === 200) { ready = true; break; }",
                  "    if (response.code !== 404) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Onboarding request failed: HTTP ' + response.code); }",
                  "    await new Promise(resolve => setTimeout(resolve, 1000));",
                  "}",
                  "if (!ready) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Registration event not applied after 60s; inspect Identity outbox and RabbitMQ consumers.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test('Wallet ready', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for Driver wallet (UserRegistered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/wallets/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let ready = false;",
                  "for (let attempt = 0; attempt < 60; attempt++) {",
                  "    const response = await pm.sendRequest({url: pm.environment.get('gatewayUrl') + '/wallets/me', method: 'GET', header: {Authorization: 'Bearer ' + pm.environment.get('driverToken')}});",
                  "    if (response.code === 200) { ready = true; break; }",
                  "    if (response.code !== 404) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Onboarding request failed: HTTP ' + response.code); }",
                  "    await new Promise(resolve => setTimeout(resolve, 1000));",
                  "}",
                  "if (!ready) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Registration event not applied after 60s; inspect Identity outbox and RabbitMQ consumers.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test('Wallet ready', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for Driver profile (DriverRegistered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/availability/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "let ready = false;",
                  "for (let attempt = 0; attempt < 60; attempt++) {",
                  "    const response = await pm.sendRequest({url: pm.environment.get('gatewayUrl') + '/availability/me', method: 'GET', header: {Authorization: 'Bearer ' + pm.environment.get('driverToken')}});",
                  "    if (response.code === 200) { ready = true; break; }",
                  "    if (response.code !== 404) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Onboarding request failed: HTTP ' + response.code); }",
                  "    await new Promise(resolve => setTimeout(resolve, 1000));",
                  "}",
                  "if (!ready) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Registration event not applied after 60s; inspect Identity outbox and RabbitMQ consumers.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test('Correct Driver profile ready', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.environment.get('driverId')); });",
                  "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
