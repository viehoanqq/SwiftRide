              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Xác nhận giá và ghép tài xế thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('DriverOffered');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": true,\n  \"paymentMethod\": \"WALLET\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/trips/{{tripId}}/confirm",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips",
                "{{tripId}}",
                "confirm"
              ]
            },
            "description": "Rider đồng ý báo giá với phương thức `WALLET`. Trip Service gọi nội bộ sang Matching Service (`POST /match`) tìm tài xế gần nhất đang `Available` và tạo lời mời (`DriverOffered`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Driver Trip Execution (Offer -> EnRoute -> Pickup -> Dropoff)",
      "item": [
        {
          "name": "4.1 Driver Poll Pending Offers (/drivers/me/offers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy danh sách lời mời của tài xế thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const offers = pm.response.json();",
                  "if (Array.isArray(offers) && offers.length > 0) {",
                  "    const targetTripId = pm.environment.get('tripId');",
                  "    const matchedOffer = offers.find(o => o.tripId === targetTripId) || offers[0];",
                  "    pm.environment.set('offerId', matchedOffer.offerId);",
                  "    pm.environment.set('tripId', matchedOffer.tripId);",
                  "    console.log('Đã nhận lời mời offerId:', matchedOffer.offerId, 'cho tripId:', matchedOffer.tripId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/drivers/me/offers",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "drivers",
                "me",
                "offers"
              ]
            }
          },
          "response": []
        },
