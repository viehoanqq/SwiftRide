                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(pm.environment.get('riderId'));",
                  "    pm.expect(res.role).to.eql('Rider');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/auth/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "me"
