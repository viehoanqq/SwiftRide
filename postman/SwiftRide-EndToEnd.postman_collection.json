    {
      "name": "05. Post-Trip Verification, Payment & Wallet (Payment & Trip Services)",
      "item": [
        {
          "name": "5.1 Rider View Completed Trip & Full History (/trips/{id})",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const url = pm.variables.replaceIn('{{gatewayUrl}}/trips/{{tripId}}');",
                  "const token = pm.environment.get('riderToken');",
                  "function waitForTrip(attempt) {",
                  "  pm.sendRequest({ url, method: 'GET', header: { Authorization: 'Bearer ' + token } }, (error, response) => {",
                  "    if (error || !response || response.code !== 200) { console.warn('Không đọc được Trip:', error || (response && response.code)); return; }",
                  "    const status = response.json().status;",
                  "    if (['Paid', 'PaymentFailed'].includes(status)) { console.log('Trip đã hoàn tất sau', attempt, 'lần kiểm tra:', status); return; }",
                  "    if (attempt < 30) { setTimeout(() => waitForTrip(attempt + 1), 2000); return; }",
                  "    console.warn('Trip vẫn', status, 'sau khoảng 60 giây; kiểm tra Saga, trip.payment-settled và _error');",
                  "  });",
                  "}",
                  "waitForTrip(1);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Xem chuyến (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const trip = pm.response.json();",
                  "  pm.test('Đúng tripId', () => pm.expect(trip.id).to.eql(pm.environment.get('tripId')));",
                  "  pm.test('WALLET chuẩn phải kết thúc Paid', () => pm.expect(trip.status).to.eql('Paid'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/trips/{{tripId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips",
                "{{tripId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "5.2 Rider Get Payment Details By Trip (/payments/by-trip/{tripId})",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const url = pm.variables.replaceIn('{{gatewayUrl}}/payments/by-trip/{{tripId}}');",
                  "const token = pm.environment.get('riderToken');",
                  "function waitForPayment(attempt) {",
                  "  pm.sendRequest({ url, method: 'GET', header: { Authorization: 'Bearer ' + token } }, (error, response) => {",
                  "    if (!error && response && response.code === 200) { console.log('Payment đã sẵn sàng sau', attempt, 'lần kiểm tra'); return; }",
                  "    if (!error && response && response.code === 404 && attempt < 30) {",
                  "      setTimeout(() => waitForPayment(attempt + 1), 2000);",
                  "      return;",
                  "    }",
                  "    console.warn('Không thể chờ Payment:', error || (response && response.code), 'lần', attempt);",
                  "  });",
                  "}",
                  "waitForPayment(1);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment đã xuất hiện (200, không chấp nhận 404)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const payment = pm.response.json();",
                  "  pm.environment.set('paymentId', payment.id);",
                  "  pm.test('Đúng tripId', () => pm.expect(payment.tripId).to.eql(pm.environment.get('tripId')));",
                  "  console.log('Payment final:', payment.status, 'failureReason:', payment.failureReason, 'paymentId:', payment.id);",
                  "  pm.test('WALLET chuẩn phải thanh toán thành công', () => pm.expect(payment.status, payment.failureReason || 'Không có failureReason').to.eql('SUCCEEDED'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/payments/by-trip/{{tripId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "payments",
                "by-trip",
                "{{tripId}}"
              ]
            },
            "description": "404 chỉ là trạng thái tạm thời trước khi Payment consumer tạo bản ghi. Poll đến 200; với CARD unknown, bản ghi PENDING."
          },
          "response": []
        },
        {
          "name": "5.3 Rider Get Payment Details By PaymentId (/payments/{id})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đã có paymentId từ bước 5.2', () => pm.expect(pm.environment.get('paymentId')).to.be.ok);",
                  "pm.test('Xem payment theo ID (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test('Đúng paymentId', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('paymentId')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
