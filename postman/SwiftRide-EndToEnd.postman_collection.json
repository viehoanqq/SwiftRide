    {
      "name": "04. Driver Trip Execution (Offer -> EnRoute -> Pickup -> Dropoff)",
      "item": [
        {
          "name": "4.1 Driver Poll Pending Offers (/drivers/me/offers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy danh sách offer (200)', () => pm.response.to.have.status(200));",
                  "const offers = pm.response.json();",
                  "const target = offers.find(o => o.tripId === pm.environment.get('tripId'));",
                  "pm.test('Driver hiện tại được mời đúng chuyến', () => pm.expect(target, 'Đăng nhập Driver được mời và gọi lại').to.exist);",
                  "if (target) pm.environment.set('offerId', target.offerId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
