    {
      "name": "03. Rider Booking & Quote Confirmation (Trip Service)",
      "item": [
        {
          "name": "3.1 Rider Check Wallet Before Trip (/wallets/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy thông tin ví Rider thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('balance');",
                  "    console.log('Số dư ví Rider trước chuyến đi:', res.balance);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/wallets/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "wallets",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.2 Rider Create Trip & Get Fare Quote (POST /trips)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tạo chuyến đi và nhận báo giá thành công (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res && res.tripId) {",
                  "    pm.environment.set('tripId', res.tripId);",
                  "    console.log('Đã lưu tripId:', res.tripId, 'Giá cước:', res.price);",
                  "}",
                  "",
                  "pm.test('Trạng thái chuyến đi là Quoted và có giá cước > 0', function () {",
                  "    pm.expect(res.status).to.eql('Quoted');",
                  "    pm.expect(res.price).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{riderToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"lat\": {{pickupLat}},\n    \"lng\": {{pickupLng}},\n    \"address\": \"{{pickupAddress}}\"\n  },\n  \"dropoff\": {\n    \"lat\": {{dropoffLat}},\n    \"lng\": {{dropoffLng}},\n    \"address\": \"{{dropoffAddress}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/trips",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "trips"
              ]
            },
            "description": "Rider tạo yêu cầu đặt xe. Trip Service gọi nội bộ sang Matching Service (`POST /quote`) để tính giá và chuyển chuyến sang trạng thái `Quoted`. Tự động lưu `tripId`."
          },
          "response": []
        },
        {
          "name": "3.3 Rider Get Current Active Trip (/trips/me/current)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy chuyến hiện tại của Rider thành công (200 OK)', function () {",
