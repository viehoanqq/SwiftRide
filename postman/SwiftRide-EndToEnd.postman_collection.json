            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/payments/{{paymentId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          },
          "response": []
        },
