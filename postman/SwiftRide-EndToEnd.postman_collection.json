        {
          "name": "4.6 Driver Mark DroppedOff & Trigger Auto-Payment (/trips/{id}/dropoff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Trả khách thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(['Paid', 'PaymentPending', 'PaymentFailed']).to.include(res.status);",
