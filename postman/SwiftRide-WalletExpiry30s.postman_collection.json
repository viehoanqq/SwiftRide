    {
      "name": "Chờ Quoted và xác nhận điều kiện THIẾU TIỀN",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/trips/{{expiryTripId}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{expiryRiderToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('expiryTripId')) {",
              "pm.test('Đã có expiryTripId',()=>pm.expect.fail('Chạy collection từ đầu'));",
              "pm.execution.setNextRequest(null);pm.execution.skipRequest();",
              "}",
              "if(pm.collectionVariables.get('expiryTripId')) {",
              "let ready=false;let last='';",
              "try {",
              " for(let i=0;i<30;i++) {",
              "  const r=await pm.sendRequest({url:pm.variables.replaceIn('{{gatewayUrl}}')+'/trips/'+pm.collectionVariables.get('expiryTripId'),method:'GET',header:{Authorization:'Bearer '+pm.collectionVariables.get('expiryRiderToken')}});",
              "  if(r.code!==200){last='HTTP '+r.code;break;}",
              "  last=r.json().status;",
              "  if(last==='Quoted'){ready=true;break;}",
              "  if(last!=='Requested')break;",
              "  await new Promise(resolve=>setTimeout(resolve,1000));",
              " }",
              "}catch(e){last=e.message;}",
              "pm.test('Chờ Quoted',()=>pm.expect(ready,last).to.eql(true));",
              "if(!ready){pm.execution.setNextRequest(null);pm.execution.skipRequest();}",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let passed=true;",
              "function verify(name, fn) { pm.test(name, () => { try { fn(); } catch(e) { passed=false; throw e; } }); }",
              "verify('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(passed) {",
              "const trip=pm.response.json();",
              "const wallet=JSON.parse(pm.collectionVariables.get('expiryWalletBefore'));",
              "verify('Đúng chuyến Quoted/Pending',()=>{pm.expect(trip.id).to.eql(pm.collectionVariables.get('expiryTripId'));pm.expect(trip.status).to.eql('Quoted');pm.expect(trip.fare.status).to.eql('Pending');});",
              "verify('Giá thực tế lớn hơn số dư — không giả lập balance',()=>pm.expect(trip.fare.price,'Ví đủ tiền: đổi Rider ít tiền hoặc điểm đến xa hơn; ca này phải thiếu tiền').to.be.above(wallet.balance));",
              "if(passed){pm.collectionVariables.set('expiryHistory',JSON.stringify(trip.history));pm.collectionVariables.set('expiryObservedAt',Date.now());}",
              "console.log('TripId:',trip.id,'Giá:',trip.fare?.price,'Số dư:',wallet.balance);",
              "}",
              "if(!passed) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
