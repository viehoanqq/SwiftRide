    {
      "name": "Chờ WORKER tự hủy — không gọi /cancel",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/trips/{{expiryTripId}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{expiryRiderToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('expiryTripId')) {",
              "pm.test('Đã có expiryTripId',()=>pm.expect.fail('Chạy collection từ đầu'));",
              "pm.execution.setNextRequest(null);pm.execution.skipRequest();",
              "}",
              "if(pm.collectionVariables.get('expiryTripId')) {",
              " const limit=Number(pm.collectionVariables.get('expiryObservedAt'))+42000;",
              " let done=false;let last='';",
              " try {",
              "  while(Date.now()<limit) {",
              "   const r=await pm.sendRequest({url:pm.variables.replaceIn('{{gatewayUrl}}')+'/trips/'+pm.collectionVariables.get('expiryTripId'),method:'GET',header:{Authorization:'Bearer '+pm.collectionVariables.get('expiryRiderToken')}});",
              "   if(r.code!==200){last='HTTP '+r.code;break;}",
              "   last=r.json().status;",
              "   if(last==='Cancelled'){done=true;break;}",
              "   if(last!=='Quoted')break;",
              "   await new Promise(resolve=>setTimeout(resolve,1000));",
              "  }",
              " }catch(e){last=e.message;}",
              " pm.test('Worker tự hủy trong cửa sổ 30s + thời gian quét',()=>pm.expect(done,'Trạng thái cuối: '+last+'; kiểm tra appsettings=30, restart Trip, worker và log').to.eql(true));",
              " if(!done){pm.execution.setNextRequest(null);pm.execution.skipRequest();}",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let passed=true;",
              "function verify(name, fn) { pm.test(name, () => { try { fn(); } catch(e) { passed=false; throw e; } }); }",
              "verify('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(passed) {",
              "const trip=pm.response.json();",
              "const before=JSON.parse(pm.collectionVariables.get('expiryHistory'));",
              "verify('Cancelled, fare Rejected, không gán Driver',()=>{pm.expect(trip.id).to.eql(pm.collectionVariables.get('expiryTripId'));pm.expect(trip.status).to.eql('Cancelled');pm.expect(trip.fare.status).to.eql('Rejected');pm.expect(trip.driver).to.eql(null);});",
              "verify('Chỉ thêm đúng một dòng Quoted → Cancelled',()=>{pm.expect(trip.history.length).to.eql(before.length+1);pm.expect(trip.history.slice(0,before.length)).to.deep.eql(before);pm.expect(trip.history.at(-1).from).to.eql('Quoted');pm.expect(trip.history.at(-1).to).to.eql('Cancelled');});",
              "const utc=s=>Date.parse(/(?:Z|[+-]\\d{2}:\\d{2})$/i.test(s)?s:s+'Z');",
              "const quoted=before.find(h=>h.to==='Quoted');",
              "const seconds=(utc(trip.history.at(-1).at)-utc(quoted.at))/1000;",
              "verify('Hủy theo hạn gốc 30s, không gia hạn từ confirm lần 2',()=>{pm.expect(seconds).to.be.at.least(29);pm.expect(seconds).to.be.below(42);});",
              "if(passed)pm.collectionVariables.set('expiryCancelledHistory',JSON.stringify(trip.history));",
              "console.log('Thời gian từ Quoted đến Cancelled (giây):',seconds);",
              "}",
              "if(!passed) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
