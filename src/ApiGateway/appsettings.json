{
  "Services": {
    "trip-service": "http://localhost:5001",
    "matching-service": "http://localhost:5002",
    "payment-service": "http://localhost:5003"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "trip",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      
      "availability": {
        "ClusterId": "matching",
        "Match": { "Path": "/availability/{**catch-all}" }
      },
      "trips": {
        "ClusterId": "trip",
        "Match": { "Path": "/trips/{**catch-all}" }
      } 
    },
    "Clusters": {
      "trip": {
        "Destinations": { "d1": { "Address": "http://localhost:5001" } }
      },
      "matching": {
        "Destinations": { "d1": { "Address": "http://localhost:5002" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
  
}
