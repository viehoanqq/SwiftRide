{
  "Services": {
    "trip-service": "http://localhost:5001",
    "matching-service": "http://localhost:5002",
    "payment-service": "http://localhost:5003",
    "identity-service": "http://localhost:5004"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "availability": {
        "ClusterId": "matching",
        "Match": {
          "Path": "/availability/{**catch-all}"
        }
      },
      "trips": {
        "ClusterId": "trip",
        "Match": {
          "Path": "/trips/{**catch-all}"
        }
      },
      "driver-trip-workflow": {
        "ClusterId": "trip",
        "Match": {
          "Path": "/drivers/me/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/{id}",
          "Methods": [ "GET" ]
        }
      },
      "payment-bytrip": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/by-trip/{tripId}",
          "Methods": [ "GET" ]
        }
      },
      "wallet": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/wallets/me"
        }
      }
    },
    "Clusters": {
      "trip": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "matching": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
