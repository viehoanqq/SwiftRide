{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "availability": {
        "ClusterId": "matching",
        "Match": {
          "Path": "/availability/{**catch-all}"
        }
      },
      "trips": {
        "ClusterId": "trip",
        "Match": {
          "Path": "/trips/{**catch-all}"
        }
      },
      "driver-trip-workflow": {
        "ClusterId": "trip",
        "Match": {
          "Path": "/drivers/me/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/{id}",
          "Methods": [
            "GET"
          ]
        }
      },
      "payment-bytrip": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/by-trip/{tripId}",
          "Methods": [
            "GET"
          ]
        }
      },
      "wallet": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/wallets/me",
          "Methods": [
            "GET"
          ]
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
