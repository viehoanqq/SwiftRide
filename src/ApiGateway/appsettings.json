{
  "ReverseProxy": {
    "Routes": {
      "wallet-credit-history": {
        "ClusterId": "payment",
        "Match": { "Path": "/wallets/me/credits", "Methods": ["GET"] }
      },
      "admin-wallet-credits": {
        "ClusterId": "payment",
        "Match": { "Path": "/admin/wallets/{userId}/balance", "Methods": ["PUT"] }
      },
      "admin-wallet-credit-details": {
        "ClusterId": "payment",
        "Match": { "Path": "/admin/wallet-credits/{id}", "Methods": ["GET"] }
      },
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "availability": {
        "ClusterId": "matching",
        "Match": {
          "Path": "/availability/{**catch-all}"
        }
      },
      "trips": {
        "ClusterId": "trip",
        "Match": {
          "Path": "/trips/{**catch-all}"
        }
      },
      "driver-trip-workflow": {
        "ClusterId": "trip",
        "Match": {
          "Path": "/drivers/me/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/{id}",
          "Methods": [
            "GET"
          ]
        }
      },
      "payment-bytrip": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/by-trip/{tripId}",
          "Methods": [
            "GET"
          ]
        }
      },
      "wallet": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/wallets/me",
          "Methods": [
            "GET"
          ]
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
